<h1>ユーザー編集</h1>

<%= form_with model: @user, url: account_path(@user), method: :patch do |f| %>
  <div>
    <%= f.label :email, "メール" %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :postal_code, "郵便番号" %>
    <%= f.text_field :postal_code %>
  </div>

  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :bio, "自己紹介" %>
    <%= f.text_area :bio %>
  </div>

  <%= f.submit "更新" %>
<% end %>

<%= link_to "キャンセル", account_path(@user) %>
