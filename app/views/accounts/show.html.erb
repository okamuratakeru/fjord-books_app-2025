<h1><%= t('accounts.show.title') %></h1>

<dl>
  <dt><%= t('accounts.show.email') %></dt>
  <dd><%= @user.email %></dd>

  <dt><%= t('accounts.show.postal_code') %></dt>
  <dd><%= @user.postal_code %></dd>

  <dt><%= t('accounts.show.address') %></dt>
  <dd><%= @user.address %></dd>

  <dt><%= t('accounts.show.bio') %></dt>
  <dd><%= @user.bio %></dd>
</dl>

<%= link_to t('accounts.show.back'), accounts_path %>
<% if current_user == @user %>
  <%= link_to t('accounts.show.edit'), edit_user_registration_path %>
<% end %>
