<h2>アカウント編集</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email, "メールアドレス" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>確認待ちのメールアドレス: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <p><%= f.label :password, "パスワード" %> <i>(変更しない場合は空白のまま)</i></p>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
    <% if @minimum_password_length %>
      <p><em><%= @minimum_password_length %>文字以上</em></p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "パスワード確認" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :current_password, "現在のパスワード" %> <i>(変更を確定するために必要です)</i></p>
    <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :postal_code, "郵便番号" %></p>
    <p><%= f.text_field :postal_code %></p>
  </div>

  <div class="field">
    <p><%= f.label :address, "住所" %></p>
    <p><%= f.text_field :address %></p>
  </div>

  <div class="field">
    <p><%= f.label :bio, "自己紹介" %></p>
    <p><%= f.text_area :bio %></p>
  </div>

  <div class="actions">
    <%= f.submit "更新する" %>
  </div>
<% end %>

<h3>アカウント削除</h3>

<div><%= button_to "アカウントを削除する", registration_path(resource_name), data: { confirm: "本当に削除しますか？", turbo_confirm: "本当に削除しますか？" }, method: :delete %></div>

<%= link_to "戻る", :back %>
<%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %>
